TRAINER_ADDRESS=YOUR_TRAINER_BLUETOOTH_ADDRESS

# Optional Python HTTP forwarding; leave URL empty for terminal-only BLE reading.
WATTLAB_API_URL=
# Required by the Rust API: 32-64 URL-safe characters; local_db.py start generates it.
WATTLAB_API_TOKEN=
WATTLAB_API_PORT=8080

# PostgreSQL URLs (not JDBC); local_db.py start prepares separate Rust databases.
WATTLAB_DB_URL=
WATTLAB_DB_USER=
WATTLAB_DB_PASSWORD=
WATTLAB_TEST_DB_URL=
WATTLAB_TEST_DB_USER=
WATTLAB_TEST_DB_PASSWORD=
